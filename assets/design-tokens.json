{
  "$source": "https://devpowers.com/ (extracted 2026-11-25 with Playwright CLI, headed Chrome, desktop viewport)",
  "colors": {
    "brand": {
      "primary": "#004581",
      "primaryDark": "#003761",
      "primaryBright": "#038bfe",
      "accent": "#d30f10",
      "accentWarm": "#ffd447",
      "error": "#d30f10",
      "success": "#167a3e"
    },
    "background": {
      "default": "#fff9eb",
      "raised": "#ffffff",
      "strong": "#004581",
      "footer": "#002d52",
      "softRed": "#fff0ed",
      "softBlue": "#eaf5ff",
      "chatClient": "#fff1b8",
      "chatAgent": "#d9ecff",
      "overlay": "rgba(0, 31, 57, 0.88)"
    },
    "text": {
      "primary": "#101820",
      "muted": "#4c5b66",
      "onDark": "#ffffff",
      "onAccent": "#ffffff",
      "onAccentWarm": "#101820"
    },
    "line": {
      "hairline": "#101820",
      "shadow": "#101820"
    },
    "dark": {
      "$note": "Applied via the html.dark class (theme toggle in the header)",
      "surface": "#17121d",
      "surfaceRaised": "#241c2e",
      "surfaceStrong": "#0d3b66",
      "onSurface": "#f7efe1",
      "onSurfaceStrong": "#ffffff",
      "muted": "#c3b4a6",
      "accent": "#ff3b30",
      "onAccent": "#1a0d0c",
      "accentWarm": "#ffd233",
      "onAccentWarm": "#191016",
      "positive": "#6bdd97",
      "negative": "#ff5a4d",
      "chatClient": "#4a3a12",
      "chatAgent": "#14395c",
      "hairline": "#f7efe1",
      "hairlineStrong": "#ffffff",
      "shadow": "#000000",
      "softRed": "#3b1a1a",
      "softBlue": "#132c44"
    }
  },
  "cssVariables": {
    "--surface": "#fff9eb",
    "--surface-raised": "#fff",
    "--surface-strong": "#004581",
    "--on-surface": "#101820",
    "--on-surface-strong": "#fff",
    "--muted": "#4c5b66",
    "--accent": "#d30f10",
    "--on-accent": "#fff",
    "--accent-warm": "#ffd447",
    "--on-accent-warm": "#101820",
    "--positive": "#167a3e",
    "--negative": "#d30f10",
    "--chat-client": "#fff1b8",
    "--chat-agent": "#d9ecff",
    "--hairline": "#101820",
    "--shadow": "#101820",
    "--soft-red": "#fff0ed",
    "--soft-blue": "#eaf5ff"
  },
  "typography": {
    "fontFamily": {
      "display": "Bangers, sans-serif",
      "primary": "\"Atkinson Hyperlegible\", sans-serif"
    },
    "fontSource": "https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bangers&display=swap",
    "fontWeights": { "regular": 400, "bold": 700 },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "md": "18px",
      "lg": "20px",
      "lead": "21.6px",
      "xl": "24px",
      "2xl": "28px",
      "h3": "29.6px",
      "h2": "51.4px",
      "h1": "55.2px"
    },
    "lineHeight": { "display": "1.0", "heading": "1.08", "base": "1.5", "relaxed": "1.625" },
    "letterSpacing": { "display": "0.02em" }
  },
  "spacing": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "12": "48px", "16": "64px",
    "section": "65.45px"
  },
  "borderRadius": {
    "none": "0px",
    "sm": "6px",
    "button": "7px",
    "md": "8px",
    "card": "10px",
    "lg": "16px",
    "bubble": "14px 14px 14px 4px",
    "circle": "50%"
  },
  "borderWidth": { "thin": "2px", "default": "3px", "thick": "4px" },
  "shadow": {
    "sm": "3px 3px 0 0 #101820",
    "md": "4px 4px 0 0 #101820",
    "lg": "6px 6px 0 0 #101820",
    "accent": "6px 6px 0 0 #d30f10",
    "warm": "6px 6px 0 0 #ffd447"
  },
  "layout": { "proseMax": "832px", "narrowMax": "672px" },
  "components": {
    "button": {
      "primary": {
        "backgroundColor": "#d30f10", "color": "#ffffff",
        "fontFamily": "Bangers, sans-serif", "fontSize": "20px", "letterSpacing": "0.4px",
        "padding": "10.4px 16px", "borderRadius": "7px",
        "border": "3px solid #101820", "boxShadow": "4px 4px 0 0 #101820"
      },
      "light": {
        "backgroundColor": "#ffffff", "color": "#101820",
        "fontFamily": "Bangers, sans-serif", "fontSize": "20px",
        "padding": "10.4px 16px", "borderRadius": "7px",
        "border": "3px solid #101820", "boxShadow": "4px 4px 0 0 #101820"
      }
    },
    "sticker": {
      "backgroundColor": "#ffd447", "color": "#101820",
      "fontFamily": "Bangers, sans-serif", "fontSize": "20px",
      "padding": "5.6px 11.2px", "borderRadius": "10px",
      "border": "3px solid #101820", "boxShadow": "3px 3px 0 0 #101820",
      "transform": "rotate(-1deg)"
    },
    "card": {
      "backgroundColor": "#ffffff", "padding": "24px", "borderRadius": "10px",
      "border": "3px solid #101820", "boxShadow": "6px 6px 0 0 #101820"
    },
    "header": { "backgroundColor": "#fff9eb", "position": "sticky", "height": "76px" },
    "nav": { "color": "#101820", "fontSize": "14px", "fontWeight": 700 },
    "band": {
      "backgroundColors": ["#038bfe", "#004581", "#003761"],
      "color": "#ffffff", "borderTop": "3px solid #101820", "padding": "65.45px 0"
    },
    "chatBubble": {
      "client": { "backgroundColor": "#fff1b8", "borderRadius": "14px 14px 4px" },
      "agent": { "backgroundColor": "#d9ecff", "borderRadius": "14px 14px 14px 4px" }
    },
    "footer": { "backgroundColor": "#002d52", "color": "#ffffff", "padding": "48px 0" }
  }
}
