{
  "name": "copilot-backend",
  "private": true,
  "type": "module",
  "description": "Hardware Service Decision Copilot backend (ADR-005: Node 24 + TypeScript + Fastify)",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "openai": "^7.65.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
