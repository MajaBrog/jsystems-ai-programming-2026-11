# Copy to .env in the checkout root. app/scripts/with-env.sh exports these
# variables (only those not already set in the environment).

# Required: OpenRouter API key; the backend fails fast at startup if empty.
OPENROUTER_API_KEY=

# Optional (defaults shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-6-luna
# Defaults to LLM_MODEL when empty
LLM_VISION_MODEL=
# Per-call timeout in seconds (PRD AC-30)
LLM_TIMEOUT_SECONDS=60
# Attribution header X-OpenRouter-Title
OPENROUTER_APP_TITLE=Hardware Service Decision Copilot
# Directory for copilot.db and uploads/
APP_DATA_DIR=./data
SERVER_PORT=8080
